# PostgreSQL connection string for local development/production.
# Never commit the real DATABASE_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/student_resource_hub?schema=public"

# Auth.js secret. Generate a strong random value for each environment.
AUTH_SECRET="replace-with-a-long-random-secret"

# Used only by `npm run db:seed` to provision the first admin account.
# Never commit real credentials.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-12-plus-character-password"
